{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Netdata Functions UI Response",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "anyOf": [{ "type": "integer" }, { "$ref": "#/definitions/traces_status" }]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/info_response" },
    { "$ref": "#/definitions/data_response" },
    { "$ref": "#/definitions/topology_response" },
    { "$ref": "#/definitions/flows_response" },
    { "$ref": "#/definitions/traces_response" },
    { "$ref": "#/definitions/traces_values_response" },
    { "$ref": "#/definitions/traces_trace_response" },
    { "$ref": "#/definitions/error_response" },
    { "$ref": "#/definitions/not_modified_response" }
  ],
  "definitions": {
    "field_type": {
      "type": "string",
      "enum": [
        "none",
        "integer",
        "float",
        "boolean",
        "string",
        "detail-string",
        "bar-with-integer",
        "duration",
        "timestamp",
        "array",
        "feedTemplate"
      ]
    },
    "field_visual": {
      "type": "string",
      "enum": [
        "value",
        "bar",
        "pill",
        "richValue",
        "rowOptions",
        "feedTemplate"
      ]
    },
    "field_transform": {
      "type": "string",
      "enum": [
        "none",
        "number",
        "duration",
        "datetime",
        "datetime_usec",
        "xml",
        "text"
      ]
    },
    "field_sort": {
      "type": "string",
      "enum": ["ascending", "descending"]
    },
    "field_summary": {
      "type": "string",
      "enum": ["count", "uniqueCount", "sum", "min", "max", "mean", "median"]
    },
    "field_filter": {
      "type": "string",
      "enum": ["none", "range", "multiselect", "facet"]
    },
    "facet_value": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "facet_field": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "type": "string" },
        "name": { "type": "string" },
        "total_values": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "autocomplete": { "type": "boolean" },
        "overflowed": { "type": "boolean" },
        "overflow_records": { "type": "integer", "minimum": 0 },
        "values": {
          "type": "array",
          "items": { "$ref": "#/definitions/facet_value" }
        }
      },
      "additionalProperties": true
    },
    "facets": {
      "type": "object",
      "properties": {
        "value_limit": { "type": "integer" },
        "excluded_fields": { "type": "array", "items": { "type": "string" } },
        "overflowed_fields": { "type": "integer" },
        "overflowed_records": { "type": "integer" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/facet_field" }
        },
        "auto": { "type": "object" }
      },
      "additionalProperties": true
    },
    "value_options": {
      "type": "object",
      "properties": {
        "units": { "type": ["string", "null"] },
        "transform": { "$ref": "#/definitions/field_transform" },
        "decimal_points": { "type": "integer", "minimum": 0 },
        "default_value": { "type": ["string", "number", "boolean", "null"] }
      },
      "additionalProperties": true
    },
    "column": {
      "type": "object",
      "required": ["index", "name", "type"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "unique_key": { "type": "boolean" },
        "name": { "type": "string" },
        "type": { "$ref": "#/definitions/field_type" },
        "units": { "type": ["string", "null"] },
        "visualization": { "$ref": "#/definitions/field_visual" },
        "value_options": { "$ref": "#/definitions/value_options" },
        "max": { "type": "number" },
        "pointer_to": { "type": ["string", "null"] },
        "sort": { "$ref": "#/definitions/field_sort" },
        "sortable": { "type": "boolean" },
        "sticky": { "type": "boolean" },
        "summary": { "$ref": "#/definitions/field_summary" },
        "filter": { "$ref": "#/definitions/field_filter" },
        "full_width": { "type": "boolean" },
        "wrap": { "type": "boolean" },
        "default_expanded_filter": { "type": "boolean" },
        "dummy": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "columns": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/column" }
    },
    "required_param_option": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "defaultSelected": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "sort": { "$ref": "#/definitions/field_sort" }
      },
      "additionalProperties": true
    },
    "required_param": {
      "type": "object",
      "required": ["id", "name", "type", "options"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["select", "multiselect"] },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/required_param_option" }
        },
        "help": { "type": "string" },
        "unique_view": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "accepted_params": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_params": {
      "type": "array",
      "items": { "$ref": "#/definitions/required_param" }
    },
    "chart_config": {
      "type": "object",
      "required": ["name", "type", "columns"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "group_by_config": {
      "type": "object",
      "required": ["name", "columns"],
      "properties": {
        "name": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "info_response": {
      "type": "object",
      "required": ["status", "type", "has_history", "accepted_params", "required_params", "v"],
      "properties": {
        "status": { "type": "integer" },
        "type": { "type": "string" },
        "has_history": { "type": "boolean" },
        "accepted_params": { "$ref": "#/definitions/accepted_params" },
        "required_params": { "$ref": "#/definitions/required_params" },
        "v": { "type": "integer" },
        "help": { "type": "string" },
        "update_every": { "type": "integer" },
        "expires": { "type": "integer" },
        "presentation": { "$ref": "#/definitions/topology_presentation" }
      },
      "allOf": [
        { "not": { "required": ["columns"] } },
        { "not": { "required": ["data"] } }
      ],
      "if": { "required": ["type"], "properties": { "type": { "const": "traces" } } },
      "then": { "$ref": "#/definitions/traces_info" },
      "additionalProperties": true
    },
    "data_response": {
      "type": "object",
      "required": ["status", "type", "columns", "data"],
      "properties": {
        "status": { "type": "integer" },
        "type": { "type": "string", "enum": ["table", "log"] },
        "columns": { "$ref": "#/definitions/columns" },
        "data": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {}
          }
        },
        "has_history": { "type": "boolean" },
        "accepted_params": { "$ref": "#/definitions/accepted_params" },
        "required_params": { "$ref": "#/definitions/required_params" },
        "help": { "type": "string" },
        "update_every": { "type": "integer" },
        "expires": { "type": "integer" },
        "default_sort_column": { "type": "string" },
        "group_by": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/group_by_config" }
        },
        "charts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/chart_config" }
        },
        "default_charts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "facets": { "$ref": "#/definitions/facets" },
        "histogram": { "type": "object" },
        "items": { "type": "object" },
        "pagination": { "type": "object" }
      },
      "additionalProperties": true
    },
    "topology_presentation_actor_type": {
      "type": "object",
      "required": ["label", "color_slot"],
      "properties": {
        "label": { "type": "string" },
        "color_slot": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "border": { "type": "boolean" },
        "role": { "type": "string", "enum": ["actor", "endpoint"] },
        "size_by_links": { "type": "boolean" },
        "show_port_bullets": { "type": "boolean" },
        "icon_svg": { "type": "string" },
        "summary_fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_summary_field" }
        },
        "tables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/topology_presentation_table" }
        },
        "modal_tabs": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_modal_tab" }
        }
      },
      "additionalProperties": true
    },
    "topology_presentation_link_type": {
      "type": "object",
      "required": ["label", "color_slot"],
      "properties": {
        "label": { "type": "string" },
        "color_slot": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0 },
        "dash": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "topology_presentation_port_type": {
      "type": "object",
      "required": ["label", "color_slot"],
      "properties": {
        "label": { "type": "string" },
        "color_slot": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "topology_presentation_summary_field": {
      "type": "object",
      "required": ["key", "label", "sources"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "topology_presentation_table_column": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topology_presentation_table": {
      "type": "object",
      "required": ["label", "source", "columns"],
      "properties": {
        "label": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["data", "links"]
        },
        "bullet_source": { "type": "boolean" },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_table_column" }
        }
      },
      "additionalProperties": true
    },
    "topology_presentation_modal_tab": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topology_presentation_legend_entry": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topology_presentation_legend": {
      "type": "object",
      "required": ["actors", "links"],
      "properties": {
        "actors": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_legend_entry" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_legend_entry" }
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/definitions/topology_presentation_legend_entry" }
        }
      },
      "additionalProperties": true
    },
    "topology_presentation": {
      "type": "object",
      "required": ["actor_types", "link_types", "legend", "actor_click_behavior"],
      "properties": {
        "actor_types": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/topology_presentation_actor_type" }
        },
        "link_types": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/topology_presentation_link_type" }
        },
        "port_types": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/topology_presentation_port_type" }
        },
        "legend": { "$ref": "#/definitions/topology_presentation_legend" },
        "actor_click_behavior": {
          "type": "string",
          "enum": ["highlight_connections", "highlight_path"]
        }
      },
      "additionalProperties": true
    },
    "topology_match": {
      "type": "object",
      "properties": {
        "chassis_ids": { "type": "array", "items": { "type": "string" } },
        "mac_addresses": { "type": "array", "items": { "type": "string" } },
        "ip_addresses": { "type": "array", "items": { "type": "string" } },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "dns_names": { "type": "array", "items": { "type": "string" } },
        "sys_object_id": { "type": "string" },
        "sys_name": { "type": "string" },
        "netdata_node_id": { "type": "string" },
        "netdata_machine_guid": { "type": "string" },
        "cloud_instance_id": { "type": "string" },
        "cloud_account_id": { "type": "string" },
        "container_ids": { "type": "array", "items": { "type": "string" } },
        "pod_names": { "type": "array", "items": { "type": "string" } },
        "namespace_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "topology_actor": {
      "type": "object",
      "required": ["actor_type", "layer", "source", "match"],
      "properties": {
        "actor_id": { "type": "string" },
        "actor_type": { "type": "string" },
        "layer": { "type": "string" },
        "source": { "type": "string" },
        "match": { "$ref": "#/definitions/topology_match" },
        "parent_match": { "$ref": "#/definitions/topology_match" },
        "attributes": { "type": "object" },
        "derived": { "type": "object" },
        "labels": { "type": "object" },
        "tables": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "additionalProperties": true
    },
    "topology_link_endpoint": {
      "type": "object",
      "properties": {
        "match": { "$ref": "#/definitions/topology_match" },
        "attributes": { "type": "object" }
      },
      "additionalProperties": true
    },
    "topology_link": {
      "type": "object",
      "required": ["layer", "protocol", "src", "dst"],
      "properties": {
        "layer": { "type": "string" },
        "protocol": { "type": "string" },
        "link_type": { "type": "string" },
        "direction": { "type": "string" },
        "state": { "type": "string" },
        "src_actor_id": { "type": "string" },
        "dst_actor_id": { "type": "string" },
        "src": { "$ref": "#/definitions/topology_link_endpoint" },
        "dst": { "$ref": "#/definitions/topology_link_endpoint" },
        "discovered_at": { "type": "string", "format": "date-time" },
        "last_seen": { "type": "string", "format": "date-time" },
        "metrics": { "type": "object" }
      },
      "additionalProperties": true
    },
    "topology_flow_exporter": {
      "type": "object",
      "properties": {
        "ip": { "type": "string" },
        "name": { "type": "string" },
        "sampling_rate": { "type": "integer" },
        "flow_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "topology_flow": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "duration_sec": { "type": "integer" },
        "exporter": { "$ref": "#/definitions/topology_flow_exporter" },
        "src": { "$ref": "#/definitions/topology_link_endpoint" },
        "dst": { "$ref": "#/definitions/topology_link_endpoint" },
        "key": { "type": "object" },
        "metrics": { "type": "object" }
      },
      "additionalProperties": true
    },
    "topology_ip_policy": {
      "type": "object",
      "properties": {
        "public_allowlist": { "type": "array", "items": { "type": "string" } },
        "live_top_n": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "limit": { "type": "integer" },
            "sort_by": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "topology_response": {
      "type": "object",
      "required": ["status", "type", "data"],
      "properties": {
        "status": { "type": "integer" },
        "type": { "const": "topology" },
        "data": {
          "type": "object",
          "required": ["schema_version", "agent_id", "collected_at", "actors", "links"],
          "properties": {
            "schema_version": { "type": "string" },
            "source": { "type": "string" },
            "layer": { "type": "string" },
            "agent_id": { "type": "string" },
            "collected_at": { "type": "string", "format": "date-time" },
            "view": { "type": "string" },
            "group_by": {
              "type": "array",
              "items": { "type": "string" }
            },
            "columns": { "$ref": "#/definitions/columns" },
            "metric": { "type": "string" },
            "chart": { "type": "object" },
            "ip_policy": { "$ref": "#/definitions/topology_ip_policy" },
            "actors": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_actor" }
            },
            "links": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_link" }
            },
            "flows": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_flow" }
            },
            "stats": { "type": "object" },
            "metrics": { "type": "object" }
          },
          "additionalProperties": true
        },
        "has_history": { "type": "boolean" },
        "accepted_params": { "$ref": "#/definitions/accepted_params" },
        "required_params": { "$ref": "#/definitions/required_params" },
        "help": { "type": "string" },
        "update_every": { "type": "integer" },
        "expires": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "flows_response": {
      "type": "object",
      "required": ["status", "type", "data"],
      "properties": {
        "status": { "type": "integer" },
        "type": { "const": "flows" },
        "data": {
          "type": "object",
          "required": ["schema_version", "agent_id", "collected_at"],
          "properties": {
            "schema_version": { "type": "string" },
            "source": { "type": "string" },
            "layer": { "type": "string" },
            "agent_id": { "type": "string" },
            "collected_at": { "type": "string", "format": "date-time" },
            "view": { "type": "string" },
            "ip_policy": { "$ref": "#/definitions/topology_ip_policy" },
            "actors": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_actor" }
            },
            "links": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_link" }
            },
            "flows": {
              "type": "array",
              "items": { "$ref": "#/definitions/topology_flow" }
            },
            "stats": { "type": "object" },
            "metrics": { "type": "object" },
            "warnings": { "type": ["array", "object"] },
            "facets": { "$ref": "#/definitions/facets" },
            "histogram": { "type": "object" },
            "visualizations": { "type": "object" },
            "pagination": { "type": "object" }
          },
          "additionalProperties": true
        },
        "has_history": { "type": "boolean" },
        "accepted_params": { "$ref": "#/definitions/accepted_params" },
        "required_params": { "$ref": "#/definitions/required_params" },
        "help": { "type": "string" },
        "update_every": { "type": "integer" },
        "expires": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "traces_partial_reason": {
      "type": "string",
      "enum": [
        "size_cap",
        "source_failure",
        "cancelled",
        "remote_unavailable",
        "legacy_file",
        "stack_field_high_card",
        "facet_high_card",
        "facet_value_cap",
        "groups_cap",
        "live_pass_failed"
      ]
    },
    "traces_status": {
      "oneOf": [
        {
          "type": "object",
          "required": ["complete"],
          "properties": {
            "complete": { "const": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["partial"],
          "properties": {
            "partial": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["reason", "count"],
                "properties": {
                  "reason": { "$ref": "#/definitions/traces_partial_reason" },
                  "count": { "type": "integer", "minimum": 1 },
                  "of": { "type": "integer", "minimum": 1 },
                  "detail": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "traces_coverage": {
      "type": "object",
      "required": ["after", "before"],
      "properties": {
        "after": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "before": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "traces_string_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" }
    },
    "traces_field_kinds": {
      "type": "object",
      "required": ["fields", "event_attributes", "link_attributes"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        },
        "event_attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        },
        "link_attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        }
      },
      "additionalProperties": true
    },
    "traces_event": {
      "type": "object",
      "required": ["time_unix_nano", "name", "dropped_attributes_count", "attributes"],
      "properties": {
        "time_unix_nano": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        }
      },
      "additionalProperties": true
    },
    "traces_link": {
      "type": "object",
      "required": [
        "trace_id",
        "span_id",
        "trace_state",
        "flags",
        "dropped_attributes_count",
        "attributes"
      ],
      "properties": {
        "trace_id": { "type": "string" },
        "span_id": { "type": "string" },
        "trace_state": { "type": "string" },
        "flags": { "type": "integer", "minimum": 0 },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        }
      },
      "additionalProperties": true
    },
    "traces_span": {
      "type": "object",
      "required": [
        "span_id",
        "start_ns",
        "duration_ns",
        "self_duration_ns",
        "error_origin",
        "kind",
        "flags",
        "dropped_attributes_count",
        "dropped_events_count",
        "dropped_links_count",
        "fields",
        "events",
        "links"
      ],
      "properties": {
        "span_id": { "type": "string" },
        "parent_span_id": { "type": "string" },
        "start_ns": { "type": "integer" },
        "duration_ns": { "type": "integer" },
        "self_duration_ns": { "type": "integer", "minimum": 0 },
        "error_origin": { "type": "boolean" },
        "kind": { "type": "integer" },
        "flags": { "type": "integer", "minimum": 0 },
        "dropped_attributes_count": { "type": "integer", "minimum": 0 },
        "dropped_events_count": { "type": "integer", "minimum": 0 },
        "dropped_links_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_string_pair" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_event" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_link" }
        }
      },
      "additionalProperties": true
    },
    "traces_decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "traces_explore_window": {
      "type": "object",
      "required": ["after", "before", "grid"],
      "properties": {
        "after": { "type": "integer", "minimum": 0 },
        "before": { "type": "integer", "minimum": 0 },
        "grid": {
          "type": "object",
          "required": ["start_ns", "bucket_ns", "buckets"],
          "properties": {
            "start_ns": { "$ref": "#/definitions/traces_decimal" },
            "bucket_ns": { "type": "integer", "minimum": 1 },
            "buckets": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "traces_histogram_bucket": {
      "type": "object",
      "required": ["counts", "unset", "other"],
      "properties": {
        "counts": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "unset": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 },
        "p50_ns": { "type": "integer" },
        "p95_ns": { "type": "integer" },
        "p99_ns": { "type": "integer" }
      },
      "dependencies": {
        "p50_ns": ["p95_ns", "p99_ns"],
        "p95_ns": ["p50_ns", "p99_ns"],
        "p99_ns": ["p50_ns", "p95_ns"]
      },
      "additionalProperties": false
    },
    "traces_histogram_totals": {
      "type": "object",
      "required": ["count", "errors"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "p50_ns": { "type": "integer" },
        "p95_ns": { "type": "integer" },
        "p99_ns": { "type": "integer" }
      },
      "dependencies": {
        "p50_ns": ["p95_ns", "p99_ns"],
        "p95_ns": ["p50_ns", "p99_ns"],
        "p99_ns": ["p50_ns", "p95_ns"]
      },
      "additionalProperties": false
    },
    "traces_histogram": {
      "type": "object",
      "required": ["status", "stack", "dimensions", "buckets", "totals"],
      "properties": {
        "status": { "$ref": "#/definitions/traces_status" },
        "stack": { "type": "string" },
        "dimensions": { "type": "array", "items": { "type": "string" } },
        "buckets": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_histogram_bucket" }
        },
        "totals": { "$ref": "#/definitions/traces_histogram_totals" },
        "percentiles": {
          "type": "object",
          "required": ["approximate", "max_relative_error"],
          "properties": {
            "approximate": { "type": "boolean" },
            "max_relative_error": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "traces_explore_facet_value": {
      "type": "object",
      "required": ["value", "count"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "count": { "type": "integer", "minimum": 0 },
        "selection": { "type": "integer", "minimum": 0 },
        "baseline": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "boolean" },
        "rank": { "type": "integer", "minimum": 1 },
        "diff": { "type": "number" }
      },
      "additionalProperties": false
    },
    "traces_explore_facet": {
      "type": "object",
      "required": ["field", "values", "omitted_values", "omitted_rows"],
      "properties": {
        "field": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_explore_facet_value" }
        },
        "omitted_values": { "type": "integer", "minimum": 0 },
        "omitted_rows": { "type": "integer", "minimum": 0 },
        "rank": { "type": "integer", "minimum": 1 },
        "best_diff": { "type": "number" },
        "totals": {
          "type": "object",
          "required": ["scope", "selection"],
          "properties": {
            "scope": { "type": "integer", "minimum": 0 },
            "selection": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "in_selection": { "const": true }
      },
      "additionalProperties": false,
      "if": { "required": ["in_selection"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["rank"] },
            { "required": ["best_diff"] },
            { "required": ["totals"] }
          ]
        }
      }
    },
    "traces_explore_facets": {
      "type": "object",
      "required": ["status", "fields", "unavailable"],
      "properties": {
        "status": { "$ref": "#/definitions/traces_status" },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/traces_explore_facet" } },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "reason"],
            "properties": {
              "field": { "type": "string" },
              "reason": { "$ref": "#/definitions/traces_partial_reason" }
            },
            "additionalProperties": false
          }
        },
        "comparison": {
          "type": "object",
          "required": ["scope", "selection", "min_support"],
          "properties": {
            "scope": { "type": "integer", "minimum": 0 },
            "selection": { "type": "integer", "minimum": 0 },
            "min_support": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "traces_group": {
      "type": "object",
      "required": [
        "service",
        "operation",
        "spans",
        "errors",
        "errors_originated",
        "p95_ns",
        "self_ns"
      ],
      "properties": {
        "service": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] },
        "spans": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "errors_originated": { "type": "integer", "minimum": 0 },
        "p95_ns": { "type": ["integer", "null"] },
        "self_ns": { "$ref": "#/definitions/traces_decimal" }
      },
      "additionalProperties": false
    },
    "traces_delta_side": {
      "type": "object",
      "required": ["spans", "errors_originated", "self_ns"],
      "properties": {
        "spans": { "type": "integer", "minimum": 0 },
        "errors_originated": { "type": "integer", "minimum": 0 },
        "self_ns": { "$ref": "#/definitions/traces_decimal" }
      },
      "additionalProperties": false
    },
    "traces_groups_delta": {
      "type": "object",
      "required": [
        "selection_traces",
        "baseline_traces",
        "selection_self_ns_total",
        "baseline_self_ns_total",
        "rows",
        "other"
      ],
      "properties": {
        "selection_traces": { "type": "integer", "minimum": 0 },
        "baseline_traces": { "type": "integer", "minimum": 0 },
        "selection_self_ns_total": { "$ref": "#/definitions/traces_decimal" },
        "baseline_self_ns_total": { "$ref": "#/definitions/traces_decimal" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "operation", "selection", "baseline"],
            "properties": {
              "service": { "type": ["string", "null"] },
              "operation": { "type": ["string", "null"] },
              "selection": { "$ref": "#/definitions/traces_delta_side" },
              "baseline": { "$ref": "#/definitions/traces_delta_side" }
            },
            "additionalProperties": false
          }
        },
        "other": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["groups", "selection", "baseline"],
              "properties": {
                "groups": { "type": "integer", "minimum": 0 },
                "selection": { "$ref": "#/definitions/traces_delta_side" },
                "baseline": { "$ref": "#/definitions/traces_delta_side" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "traces_groups": {
      "type": "object",
      "required": ["status", "window_s", "self_ns_total", "rows", "other"],
      "properties": {
        "status": { "$ref": "#/definitions/traces_status" },
        "window_s": { "type": "integer", "minimum": 0 },
        "self_ns_total": { "$ref": "#/definitions/traces_decimal" },
        "rows": { "type": "array", "items": { "$ref": "#/definitions/traces_group" } },
        "other": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["groups", "spans", "errors", "errors_originated", "p95_ns", "self_ns"],
              "properties": {
                "groups": { "type": "integer", "minimum": 0 },
                "spans": { "type": "integer", "minimum": 0 },
                "errors": { "type": "integer", "minimum": 0 },
                "errors_originated": { "type": "integer", "minimum": 0 },
                "p95_ns": { "type": ["integer", "null"] },
                "self_ns": { "$ref": "#/definitions/traces_decimal" }
              },
              "additionalProperties": false
            }
          ]
        },
        "delta": { "$ref": "#/definitions/traces_groups_delta" }
      },
      "additionalProperties": false
    },
    "traces_row": {
      "type": "object",
      "required": [
        "cursor",
        "start_ns",
        "duration_ns",
        "self_duration_ns",
        "trace_id",
        "span_id",
        "service",
        "name",
        "role",
        "status",
        "columns"
      ],
      "properties": {
        "cursor": { "type": "string" },
        "start_ns": { "$ref": "#/definitions/traces_decimal" },
        "duration_ns": { "type": "integer" },
        "self_duration_ns": { "type": ["integer", "null"] },
        "trace_id": { "type": "string" },
        "span_id": { "type": "string" },
        "service": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "columns": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "traces_rows": {
      "type": "object",
      "required": ["status", "order", "matched", "items"],
      "properties": {
        "status": { "$ref": "#/definitions/traces_status" },
        "order": { "enum": ["newest", "slowest"] },
        "matched": { "type": "integer", "minimum": 0 },
        "has_older": { "type": "boolean" },
        "has_newer": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/traces_row" } }
      },
      "additionalProperties": false
    },
    "traces_fields": {
      "type": "object",
      "required": ["status", "items", "columns"],
      "properties": {
        "status": { "$ref": "#/definitions/traces_status" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tier", "chip", "facet", "stack", "text", "column"],
            "properties": {
              "name": { "type": "string" },
              "tier": { "enum": ["low", "mid", "high"] },
              "chip": { "type": "boolean" },
              "facet": { "type": "boolean" },
              "stack": { "type": "boolean" },
              "text": { "type": "boolean" },
              "column": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "columns": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "traces_explore_data": {
      "type": "object",
      "required": ["mode", "version", "window", "status"],
      "properties": {
        "mode": { "const": "explore" },
        "version": { "type": "integer" },
        "window": { "$ref": "#/definitions/traces_explore_window" },
        "status": { "$ref": "#/definitions/traces_status" },
        "histogram": { "$ref": "#/definitions/traces_histogram" },
        "facets": { "$ref": "#/definitions/traces_explore_facets" },
        "groups": { "$ref": "#/definitions/traces_groups" },
        "rows": { "$ref": "#/definitions/traces_rows" },
        "fields": { "$ref": "#/definitions/traces_fields" }
      },
      "additionalProperties": false
    },
    "traces_values_response": {
      "type": "object",
      "required": ["mode", "version", "field", "values", "truncated", "status"],
      "properties": {
        "mode": { "const": "values" },
        "version": { "type": "integer" },
        "field": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "truncated": { "type": "boolean" },
        "status": { "$ref": "#/definitions/traces_status" }
      },
      "additionalProperties": false
    },
    "traces_trace_response": {
      "type": "object",
      "required": [
        "mode",
        "version",
        "trace_id",
        "coverage",
        "status",
        "items",
        "summary_root",
        "roots",
        "children",
        "spans",
        "field_kinds",
        "log_streams"
      ],
      "properties": {
        "mode": { "const": "trace" },
        "version": { "type": "integer" },
        "trace_id": { "type": "string" },
        "coverage": { "$ref": "#/definitions/traces_coverage" },
        "status": { "$ref": "#/definitions/traces_status" },
        "items": {
          "type": "object",
          "required": ["returned"],
          "properties": { "returned": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        },
        "summary_root": { "type": ["integer", "null"], "minimum": 0 },
        "roots": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "children": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        },
        "spans": { "type": "array", "items": { "$ref": "#/definitions/traces_span" } },
        "field_kinds": { "$ref": "#/definitions/traces_field_kinds" },
        "log_streams": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "traces_info": {
      "type": "object",
      "required": [
        "mode",
        "version",
        "sections",
        "defaults",
        "limits",
        "percentiles",
        "approximations",
        "duration_bands",
        "partial_reasons"
      ],
      "properties": {
        "mode": { "const": "info" },
        "version": { "type": "integer" },
        "sections": {
          "type": "array",
          "items": { "enum": ["histogram", "facets", "groups", "rows", "fields"] }
        },
        "defaults": {
          "type": "object",
          "required": ["filter", "stack", "window_s", "rows_limit", "values_limit"],
          "properties": {
            "filter": {
              "type": "object",
              "additionalProperties": { "type": "array", "items": { "type": "string" } }
            },
            "stack": { "type": "string" },
            "window_s": { "type": "integer", "minimum": 1 },
            "rows_limit": { "type": "integer", "minimum": 1 },
            "values_limit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "limits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "percentiles": {
          "type": "object",
          "required": ["approximate", "max_relative_error", "label"],
          "properties": {
            "approximate": { "type": "boolean" },
            "max_relative_error": { "type": "number", "minimum": 0 },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        },
        "approximations": {
          "type": "object",
          "required": ["origin_and_self_time", "label"],
          "properties": {
            "origin_and_self_time": { "type": "string" },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        },
        "duration_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "min_ns", "max_ns"],
            "properties": {
              "label": { "type": "string" },
              "min_ns": { "type": "integer", "minimum": 0 },
              "max_ns": { "type": ["integer", "null"] }
            },
            "additionalProperties": false
          }
        },
        "partial_reasons": {
          "type": "array",
          "items": { "$ref": "#/definitions/traces_partial_reason" }
        }
      },
      "additionalProperties": true
    },
    "traces_response": {
      "type": "object",
      "required": ["status", "type", "data"],
      "properties": {
        "status": { "type": "integer" },
        "type": { "const": "traces" },
        "data": { "$ref": "#/definitions/traces_explore_data" },
        "has_history": { "type": "boolean" },
        "accepted_params": { "$ref": "#/definitions/accepted_params" },
        "required_params": { "$ref": "#/definitions/required_params" },
        "help": { "type": "string" },
        "update_every": { "type": "integer" },
        "expires": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "error_response": {
      "type": "object",
      "required": ["status", "errorMessage"],
      "properties": {
        "status": { "type": "integer", "minimum": 400 },
        "errorMessage": { "type": "string" },
        "error": { "type": "string" },
        "message": { "type": "string" },
        "help": { "type": "string" }
      },
      "additionalProperties": true
    },
    "not_modified_response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "const": 304 }
      },
      "additionalProperties": false
    }
  }
}
