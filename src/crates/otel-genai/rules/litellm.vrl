# LiteLLM, both dialects: by default it puts its call type (`acompletion`, ...) into `gen_ai.operation.name` and the
# provider into `gen_ai.system`. Cache and reasoning counts exist only inside a Python repr, which is not read.
a = .attributes
call_type = a."gen_ai.operation.name"
operation = if includes(["chat", "completion", "acompletion"], call_type) {
  "chat"
} else if includes(["text_completion", "atext_completion"], call_type) {
  "text_completion"
} else if includes(["embedding", "aembedding", "embeddings"], call_type) {
  "embeddings"
} else {
  null
}
if .scope.name == "litellm" && operation != null {
  {
    "operation": operation,
    "provider": a."gen_ai.provider.name" || a."gen_ai.system",
    "request_model": a."gen_ai.request.model",
    "response_model": a."gen_ai.response.model",
    "input_tokens": a."gen_ai.usage.input_tokens",
    "output_tokens": a."gen_ai.usage.output_tokens",
    "error": .status_code == 2 || exists(a."error.type"),
    "response_id": a."gen_ai.response.id"
  }
} else {
  null
}
