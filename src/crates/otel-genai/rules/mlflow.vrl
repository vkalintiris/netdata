# MLflow tracing: every attribute value is JSON-encoded (the span type arrives as `"CHAT_MODEL"`, quotes included).
# Tokens sit in one JSON object, `mlflow.chat.tokenUsage`, whose input count already includes cache reads and writes
# (`cache_creation_input_tokens_above_1hr` is a part of the cache writes). MLflow reports no reasoning count, and a
# provider only on some paths.
a = .attributes
kind = null
if is_string(a."mlflow.spanType") { kind = parse_json(string!(a."mlflow.spanType")) ?? null }
operation = if kind == "CHAT_MODEL" {
  "chat"
} else if kind == "LLM" {
  "text_completion"
} else if kind == "EMBEDDING" {
  "embeddings"
} else {
  null
}
if .scope.name == "mlflow.tracing.provider" && operation != null {
  usage = null
  if is_string(a."mlflow.chat.tokenUsage") { usage = parse_json(string!(a."mlflow.chat.tokenUsage")) ?? null }
  if !is_object(usage) { usage = {} }
  provider = null
  if is_string(a."mlflow.llm.provider") { provider = parse_json(string!(a."mlflow.llm.provider")) ?? null }
  request_model = null
  if is_string(a.model) { request_model = parse_json(string!(a.model)) ?? null }
  response_model = null
  if is_string(a."mlflow.llm.model") { response_model = parse_json(string!(a."mlflow.llm.model")) ?? null }
  if !is_string(provider) { provider = null }
  if !is_string(request_model) { request_model = null }
  if !is_string(response_model) { response_model = null }
  {
    "operation": operation,
    "provider": provider,
    "request_model": request_model,
    "response_model": response_model,
    "input_tokens": usage.input_tokens,
    "output_tokens": usage.output_tokens,
    "cache_read_tokens": usage.cache_read_input_tokens,
    "cache_write_tokens": usage.cache_creation_input_tokens,
    "error": .status_code == 2
  }
} else {
  null
}
