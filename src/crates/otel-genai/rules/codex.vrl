# Codex counts from its `codex.sse_event` log event, the only signal with both tokens and the model. Some counts
# arrive as decimal strings. The event says nothing about the call's duration.
a = .attributes
kind = a."event.kind"
if .scope.name == "codex_otel.log_only" && a."event.name" == "codex.sse_event" && includes(["response.completed", "response.failed"], kind) {
  counts = map_values({
    "input_tokens": a.input_token_count,
    "output_tokens": a.output_token_count,
    "cache_read_tokens": a.cached_token_count,
    "cache_write_tokens": a.cache_write_token_count,
    "reasoning_tokens": a.reasoning_token_count
  }) -> |count| {
    if is_string(count) { parse_int!(count) } else { count }
  }
  merge(counts, {
    "operation": "chat",
    # The event names no provider.
    "provider": "openai",
    "request_model": a.model,
    "error": kind == "response.failed"
  })
} else {
  null
}
