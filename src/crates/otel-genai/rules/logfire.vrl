# Logfire: the conventions' names, plus the provider's own usage block in `gen_ai.usage.raw`, the only place it reports
# reasoning (OpenAI `completion_tokens_details.reasoning_tokens`, Anthropic `output_tokens_details.thinking_tokens`).
a = .attributes
operation = a."gen_ai.operation.name"
if includes(["logfire.openai", "logfire.anthropic"], .scope.name) && includes(["chat", "text_completion", "generate_content", "embeddings"], operation) {
  reasoning = null
  if is_string(a."gen_ai.usage.raw") {
    raw = parse_json(string!(a."gen_ai.usage.raw")) ?? null
    if is_object(raw) {
      reasoning = raw.completion_tokens_details.reasoning_tokens || raw.output_tokens_details.thinking_tokens
    }
  }
  {
    "operation": operation,
    "provider": a."gen_ai.provider.name" || a."gen_ai.system",
    "request_model": a."gen_ai.request.model",
    "response_model": a."gen_ai.response.model",
    "input_tokens": a."gen_ai.usage.input_tokens",
    "output_tokens": a."gen_ai.usage.output_tokens",
    "cache_read_tokens": a."gen_ai.usage.cache_read.input_tokens",
    "cache_write_tokens": a."gen_ai.usage.cache_write.input_tokens" || a."gen_ai.usage.cache_creation.input_tokens",
    "reasoning_tokens": reasoning,
    "error": .status_code == 2 || exists(a."error.type"),
    "response_id": a."gen_ai.response.id"
  }
} else {
  null
}
