# Langfuse SDK spans (`observeOpenAI` and the other wrappers): a generation's tokens sit in one JSON object,
# `langfuse.observation.usage_details`, whose keys are disjoint parts (`total` is their sum): `input` leaves out
# `input_cached_tokens` and `output` leaves out `output_reasoning_tokens`, so the parts are added back. Langfuse reports
# one model name, the answering model when known, and no provider; a failure has level ERROR.
a = .attributes
kind = a."langfuse.observation.type"
operation = if kind == "generation" {
  "chat"
} else if kind == "embedding" {
  "embeddings"
} else {
  null
}
if .scope.name == "langfuse-sdk" && operation != null {
  usage = null
  if is_string(a."langfuse.observation.usage_details") {
    usage = parse_json(string!(a."langfuse.observation.usage_details")) ?? null
  }
  if !is_object(usage) { usage = {} }
  cache_read = usage.input_cached_tokens
  reasoning = usage.output_reasoning_tokens
  input = usage.input
  if is_integer(input) && is_integer(cache_read) { input = to_int!(input) + to_int!(cache_read) }
  output = usage.output
  if is_integer(output) && is_integer(reasoning) { output = to_int!(output) + to_int!(reasoning) }
  {
    "operation": operation,
    "response_model": a."langfuse.observation.model.name",
    "input_tokens": input,
    "output_tokens": output,
    "cache_read_tokens": cache_read,
    "reasoning_tokens": reasoning,
    "error": .status_code == 2 || a."langfuse.observation.level" == "ERROR"
  }
} else {
  null
}
