# LangSmith's OTLP mode (LangChain and LangGraph): every run becomes a span with `gen_ai.operation.name`, but only runs
# of kind `llm` (`embedding`) are model calls; `prompt` runs also arrive as `chat`, with no model or tokens, so the rule
# returns false for every other kind to keep the conventions from counting them. Cache and reasoning counts sit only in
# the JSON `langsmith.metadata.usage_metadata` (input counts include cache). The provider comes from LangChain's own
# metadata (`gen_ai.system` is guessed from the model name). Failed calls arrive with status OK: a library gap.
a = .attributes
kind = a."langsmith.span.kind"
if .scope.name == "langsmith" {
  operation = if kind == "llm" { "chat" } else if kind == "embedding" { "embeddings" } else { null }
  if operation == null {
    false
  } else {
    usage = null
    if is_string(a."langsmith.metadata.usage_metadata") {
      usage = parse_json(string!(a."langsmith.metadata.usage_metadata")) ?? null
    }
    if !is_object(usage) { usage = {} }
    {
      "operation": operation,
      "provider": a."langsmith.metadata.ls_provider" || a."gen_ai.system",
      "request_model": a."gen_ai.request.model" || a."langsmith.metadata.ls_model_name",
      "response_model": a."gen_ai.response.model",
      "input_tokens": a."gen_ai.usage.input_tokens",
      "output_tokens": a."gen_ai.usage.output_tokens",
      "cache_read_tokens": usage.input_token_details.cache_read,
      "cache_write_tokens": usage.input_token_details.cache_creation,
      "reasoning_tokens": usage.output_token_details.reasoning,
      "error": .status_code == 2 || exists(a."error.type"),
      "response_id": a."gen_ai.response.id"
    }
  }
} else {
  null
}
