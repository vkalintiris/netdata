# Producers that pass on Anthropic's raw input count, which leaves out cache reads and writes: OpenLIT's Anthropic path
# and OpenLLMetry's JavaScript Anthropic instrumentation. The cache counts are added to it. OpenLIT's error span has no
# attributes at all: operation and provider fall back to constants so the failure counts.
a = .attributes
operation = a."gen_ai.operation.name" || "chat"
if includes(["openlit.instrumentation.anthropic", "@traceloop/instrumentation-anthropic"], .scope.name) && includes(["chat", "text_completion", "generate_content", "embeddings"], operation) {
  cache_read = a."gen_ai.usage.cache_read.input_tokens"
  cache_write = a."gen_ai.usage.cache_write.input_tokens" || a."gen_ai.usage.cache_creation.input_tokens"
  input = a."gen_ai.usage.input_tokens"
  if is_integer(input) {
    input = to_int!(input)
    if cache_read != null { input = input + to_int!(cache_read) }
    if cache_write != null { input = input + to_int!(cache_write) }
  }
  {
    "operation": operation,
    "provider": a."gen_ai.provider.name" || "anthropic",
    "request_model": a."gen_ai.request.model",
    "response_model": a."gen_ai.response.model",
    "input_tokens": input,
    "output_tokens": a."gen_ai.usage.output_tokens",
    "cache_read_tokens": cache_read,
    "cache_write_tokens": cache_write,
    "error": .status_code == 2 || exists(a."error.type"),
    "response_id": a."gen_ai.response.id"
  }
} else {
  null
}
