# Laminar (`lmnr`): its instrumentations use the conventions' names but send no `gen_ai.operation.name`; a model call is
# a span of type `LLM` (`lmnr.span.type`). Input counts include cache reads and writes. Laminar sets its own resource:
# the service name is the application name given to Laminar, not OTEL_SERVICE_NAME.
a = .attributes
if .scope.name == "lmnr.tracer" && a."lmnr.span.type" == "LLM" {
  {
    "operation": "chat",
    "provider": a."gen_ai.provider.name" || a."gen_ai.system",
    "request_model": a."gen_ai.request.model",
    "response_model": a."gen_ai.response.model",
    "input_tokens": a."gen_ai.usage.input_tokens",
    "output_tokens": a."gen_ai.usage.output_tokens",
    "cache_read_tokens": a."gen_ai.usage.cache_read.input_tokens",
    "cache_write_tokens": a."gen_ai.usage.cache_write.input_tokens",
    "reasoning_tokens": a."gen_ai.usage.reasoning.output_tokens",
    "error": .status_code == 2 || exists(a."error.type"),
    "response_id": a."gen_ai.response.id"
  }
} else {
  null
}
