# Datadog's tracers (`ddtrace`, `dd-trace`) with OTLP trace export: each integration span carries `gen_ai.*` tags
# written from Datadog's LLM Observability data, marked by `_dd.llmobs.artificial_gen_ai_tags`. The operation is the
# LLM Observability span kind (`llm`, `embedding`, `agent`, `tool`, ...); only `llm` and `embedding` are model calls.
# `gen_ai.request.model` holds Datadog's model name, the answering model when known; the requested model sits only in
# the integration's own tag. An unknown provider arrives as "unknown". Input counts include cache reads and writes.
a = .attributes
kind = a."gen_ai.operation.name"
operation = if kind == "llm" {
  "chat"
} else if kind == "embedding" {
  "embeddings"
} else {
  null
}
if a."_dd.llmobs.artificial_gen_ai_tags" == "true" && operation != null {
  provider = a."gen_ai.provider.name"
  if provider == "unknown" { provider = null }
  {
    "operation": operation,
    "provider": provider,
    "request_model": a."openai.request.model" || a."anthropic.request.model",
    "response_model": a."gen_ai.request.model",
    "input_tokens": a."gen_ai.usage.input_tokens",
    "output_tokens": a."gen_ai.usage.output_tokens",
    "cache_read_tokens": a."gen_ai.usage.cache_read_input_tokens",
    "cache_write_tokens": a."gen_ai.usage.cache_write_input_tokens",
    "reasoning_tokens": a."gen_ai.usage.reasoning_output_tokens",
    "error": .status_code == 2
  }
} else {
  null
}
