# global netdata configuration

[global]
	# hostname = myhost
	# flag on = yes
	# flag off = no
	# ondemand auto = auto

[db]
	# update every = 1
	# storage tiers = 3
	# cleanup obsolete charts after = 1h
	# dbengine tier 0 retention time = 14d
	# dbengine page cache size = 32MiB

[directories]
	# cache = /var/cache/netdata

[logs]
	# daemon = /var/log/netdata/daemon.log

[host labels]
	# name = value

[ml]
	# maximum num samples to train = 1.50000
	# tiny = 0.10000
	# huge = 1.0000000000000000159e+100

[web]
	# timeout = 1m
	# max request size = 1024KiB

[unknown section]
	# x = 1

[registry]
	# enabled = no

[plugins]
	# proc = yes

[statsd]
	# enabled = yes

[plugin:proc]
	# /proc/stat = yes
