load	messy.conf	0	\N -> 1
load	does-not-exist.conf	0	\N -> 0
get	global	hostname	myhost -> from-file
get_number	global	update every	1 -> 2
get	global	duplicate	\N -> second
get_boolean	global	flag on	1 -> 0
get_boolean	global	flag off	0 -> 1
get_boolean_ondemand	global	ondemand auto	1 -> 1
get_boolean_ondemand	global	ondemand2	1 -> 2
get	global	empty value	default -> 
get_number	db	update every	1 -> 16
get_number_range	db	storage tiers	3	1	5 -> 5
get_duration_seconds	db	cleanup obsolete charts after	3600 -> 60
get_duration_seconds	db	bad duration	7 -> 7
get_duration_days_to_seconds	db	dbengine tier 0 retention time	1209600 -> 1209600
get_size_mb	db	dbengine page cache size	32 -> 64
get_number	db	octal	0 -> 8
get_duration_ms	web	timeout	60000 -> 1000
get_size_bytes	web	max request size	1048576 -> 1024
get_size_bytes	web	bad size	4096 -> 4096
get_double	ml	maximum num samples to train	3ff8000000000000 -> 4004000000000000
get		in empty section	0 -> 1
get	plugin:proc	/proc/stat	yes -> no
get	spaced	k	\N -> (null)
get	long	after	\N -> 1
generate	0	1 -> 
# netdata configuration
#
# You can download the latest version of this file, using:
#
#  wget -O /etc/netdata/netdata.conf http://localhost:19999/netdata.conf
# or
#  curl -o /etc/netdata/netdata.conf http://localhost:19999/netdata.conf
#
# You can uncomment and change any of the options below.
# The value shown in the commented settings, is the default value.
#

# global netdata configuration

[global]
	#| >>> [global].hostname <<<
	#| datatype: text, default value: myhost
	hostname = from-file

	#| >>> [global].update every <<<
	#| datatype: number (integer), default value: 1
	update every = 2

	#| >>> [global].run as user <<<
	#| found in the config file, but is not used
	run as user = netdata

	#| >>> [global].not used by anyone <<<
	#| found in the config file, but is not used
	not used by anyone = 42

	duplicate = second

	#| >>> [global].flag on <<<
	#| datatype: yes or no, default value: yes
	flag on = No

	#| >>> [global].flag off <<<
	#| datatype: yes or no, default value: no
	flag off = YES

	#| >>> [global].ondemand auto <<<
	#| datatype: yes, no, or auto, default value: yes
	ondemand auto = On Demand

	#| >>> [global].ondemand2 <<<
	#| datatype: yes, no, or auto, default value: yes
	ondemand2 = on demand

	#| >>> [global].empty value <<<
	#| datatype: text, default value: default
	empty value = 

[db]
	#| >>> [db].update every <<<
	#| datatype: number (integer), default value: 1
	update every = 0x10

	#| >>> [db].storage tiers <<<
	#| datatype: number (integer), default value: 3
	storage tiers = 5

	#| >>> [db].cleanup obsolete charts after <<<
	#| reformatted from: 60
	#| datatype: duration (seconds), default value: 1h
	cleanup obsolete charts after = 1m

	#| >>> [db].bad duration <<<
	#| datatype: duration (seconds), default value: 7s
	bad duration = 7s

	#| >>> [db].dbengine tier 0 retention time <<<
	#| reformatted from: 14
	#| datatype: duration (days), default value: 14d
	dbengine tier 0 retention time = 14d

	#| >>> [db].dbengine page cache size <<<
	#| reformatted from: 64
	#| datatype: size (MiB), default value: 32MiB
	dbengine page cache size = 64MiB

	#| >>> [db].octal <<<
	#| datatype: number (integer), default value: 0
	octal = 010

[host labels]
	# name = value

[ml]
	#| >>> [ml].maximum num samples to train <<<
	#| datatype: number (double), default value: 1.50000
	maximum num samples to train = 2.50

[web]
	#| >>> [web].timeout <<<
	#| reformatted from: 1000
	#| datatype: duration (ms), default value: 1m
	timeout = 1s

	#| >>> [web].max request size <<<
	#| reformatted from: 1024
	#| datatype: size (bytes), default value: 1024KiB
	max request size = 1024B

	#| >>> [web].bad size <<<
	#| datatype: size (bytes), default value: 4KiB
	bad size = 4KiB

[]
	#| >>> [].in empty section <<<
	#| datatype: text, default value: 0
	in empty section = 1

# section 'my custom section' is not used.
[my custom section]
	a = b

# section '  spaced  ' is not used.
[  spaced  ]
	k = v

[long]
	#| >>> [long].value <<<
	#| found in the config file, but is not used
	value = 

	after = 1

[plugin:proc]
	#| >>> [plugin:proc]./proc/stat <<<
	#| datatype: text, default value: yes
	/proc/stat = no
<<<END
