
// Appended by gen-health-vectors.sh to the copy of src/health/health-config-unittest.c: runs C's unit test, which
// must pass, and writes the expectations of its file-scope table beside the rows the wrappers wrote.

int main(int argc, char **argv) {
    if(argc != 2) {
        fprintf(stderr, "usage: %s <output directory>\n", argv[0]);
        return 1;
    }

    char path[4096];
    snprintf(path, sizeof(path), "%s/c_unittest.tsv", argv[1]);
    dump_file = fopen(path, "w");
    if(!dump_file) {
        perror(path);
        return 1;
    }
    fprintf(dump_file, "# generated by tests/oracle/gen-health-vectors.sh from C's unit test; do not edit\n");
    fprintf(dump_file, "# columns: by kind, see tests/oracle/health-unittest-dump.inc\n");

    string_init();
    health_init_prototypes();

    int failed = health_config_unittest();
    if(failed) {
        fprintf(stderr, "C's unit test failed: %d\n", failed);
        return 1;
    }

    for(const db_lookup_test_case_t *test = test_cases; test->input != NULL; test++) {
        oracle_esc(dump_file, test->input);
        fprintf(dump_file, "\texpect\t%d\t%s\t%d\t%016llx\t%d\t%d\n", test->should_succeed ? 1 : 0,
                time_grouping_id2txt(test->expected_group), (int)test->expected_cond,
                dump_double_bits(test->expected_value), (int)test->expected_after, (int)test->expected_before);
    }

    fclose(dump_file);
    return 0;
}
