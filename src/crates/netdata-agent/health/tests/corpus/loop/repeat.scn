# Repeats of a warning and of a critical alert while the value moves, the CLEAR after them, and a repeating alert
# unlinked and linked again.
rules tests/corpus/loop/repeat.conf
chart loop.p loop.p_name loop.repeat - things 1
var loop.p v 10
clock 0
pass 0
var loop.p v 70
clock 1
pass 1
var loop.p v 75
clock 2
pass 2
var loop.p v 80
clock 3
pass 3
clock 4
pass 4
var loop.p v 85
clock 5
pass 5
clock 6
pass 6
var loop.p v 95
clock 7
pass 7
clock 8
pass 8
clock 9
pass 9
clock 10
pass 10
var loop.p v 10
clock 11
pass 11
clock 12
pass 12
clock 13
pass 13
var loop.p v 70
clock 14
pass 14
clock 16
pass 16
clock 17
unlink loop.p
clock 18
pending chart-init loop.p
pending host-init
pass 18
clock 20
pass 20
