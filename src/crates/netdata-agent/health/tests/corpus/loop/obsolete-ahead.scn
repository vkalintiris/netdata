# The obsolete charts again, with the wall clock 2 seconds ahead of each pass's `now`: what is stamped and what is
# due by the clock comes apart from what the pass decides by its `now`.
rules tests/corpus/loop/obsolete.conf
chart loop.o1 loop.o1_name loop.obsolete - things 1
chart loop.o2 loop.o2_name loop.obsolete.repeating - things 1
chart loop.o3 loop.o3_name loop.obsolete.live - things 1
chart loop.o4 loop.o4_name loop.obsolete.never - things 1
live loop.o1 0
live loop.o2 0
live loop.o4 0
collected loop.o4 0 0
obsolete loop.o4 1
var loop.o1 v 10
var loop.o2 v 10
var loop.o3 v 10
var loop.o4 v 10
clock 2
pass 0
obsolete loop.o1 1
obsolete loop.o2 1
clock 62
pass 60
var loop.o3 v 70
clock 63
pass 61
clock 64
pass 62
# collected again
obsolete loop.o1 0
collected loop.o1 3 63
entries loop.o1 1 63
clock 65
pass 63
# obsolete again, and a recheck of its labels once it is REMOVED
obsolete loop.o1 1
clock 202
pass 200
pending chart-recheck loop.o1
pending host-init
clock 203
pass 201
clock 302
unlink loop.o1
