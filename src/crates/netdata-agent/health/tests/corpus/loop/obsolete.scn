# An obsolete chart's alert is removed more than 60 seconds after the chart's last collection, unless it repeats.
# The removal comes in the same pass as another alert's transition; the chart is then collected again, obsolete
# again, and its labels are rechecked while its alert is REMOVED.
rules tests/corpus/loop/obsolete.conf
chart loop.o1 loop.o1_name loop.obsolete - things 1
chart loop.o2 loop.o2_name loop.obsolete.repeating - things 1
chart loop.o3 loop.o3_name loop.obsolete.live - things 1
chart loop.o4 loop.o4_name loop.obsolete.never - things 1
live loop.o1 0
live loop.o2 0
live loop.o4 0
collected loop.o4 0 0
obsolete loop.o4 1
var loop.o1 v 10
var loop.o2 v 10
var loop.o3 v 10
var loop.o4 v 10
clock 0
pass 0
obsolete loop.o1 1
obsolete loop.o2 1
clock 60
pass 60
var loop.o3 v 70
clock 61
pass 61
clock 62
pass 62
# collected again
obsolete loop.o1 0
collected loop.o1 3 63
entries loop.o1 1 63
clock 63
pass 63
# obsolete again, and a recheck of its labels once it is REMOVED
obsolete loop.o1 1
clock 200
pass 200
pending chart-recheck loop.o1
pending host-init
clock 201
pass 201
clock 300
unlink loop.o1
