# Three charts, alerts with periods of 1, 3, 7 and 100 seconds: when the pass wants to run next, the host's status
# counts, and a chart that arrives after the host's first pass.
rules tests/corpus/loop/multi.conf
chart loop.m1 loop.m1_name loop.multi - things 1
chart loop.m2 loop.m2_name loop.multi - things 1
var loop.m1 v 10
var loop.m2 v 70
clock 0
pass 0
clock 1
pass 1
clock 2
pass 2
clock 3
pass 3
chart loop.m3 loop.m3_name loop.multi.other - things 1
var loop.m3 v 1
clock 4
pass 4
clock 5
pass 5
var loop.m1 v 70
clock 7
pass 7
running 0
clock 8
pass 8
running 1
gate 0
clock 9
pass 9
gate 1
clock 10
pass 10
