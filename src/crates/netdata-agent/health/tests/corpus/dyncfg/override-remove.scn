# A file alert updated, then removed: nothing of the name is left, not the file's rules either.
rules tests/corpus/dyncfg/base.conf
chart loop.d1 loop.d1_name loop.dyncfg - things 1
chart loop.o1 loop.o1_name loop.other - things 1
var loop.d1 v 70
var loop.o1 v 70
register
clock 0
pass 0
dyncfg health:alert:prototype:d_chain remove -
clock 1
pass 1
dyncfg health:alert:prototype:d_alarm update - @tests/corpus/dyncfg/one.json
clock 2
pass 2
dyncfg health:alert:prototype:d_alarm remove -
clock 3
pass 3
dyncfg health:alert:prototype:d_alarm get -
