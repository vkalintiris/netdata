# A file alert's chain of two rules replaced by one rule: the alerts' REMOVED entries, the new link with its alarm id
# and event id, 202; a GET then says `dyncfg`. The job is not registered again.
database real
queue 1
rules tests/corpus/dyncfg/base.conf
chart loop.d1 loop.d1_name loop.dyncfg - things 1
chart loop.o1 loop.o1_name loop.other - things 1
var loop.d1 v 70
var loop.o1 v 70
register
clock 0
pass 0
store
clock 1
pass 1
store
dyncfg health:alert:prototype:d_chain get -
clock 2
dyncfg health:alert:prototype:d_chain update - @tests/corpus/dyncfg/one-b.json
store
dyncfg health:alert:prototype:d_chain get -
clock 3
pass 3
store
clock 4
pass 4
store
