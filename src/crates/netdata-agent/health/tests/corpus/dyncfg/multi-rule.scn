# Three rules in one payload: the first is a DynCfg rule, the others are not, in the GET and in the rows; the
# alarm among them is linked before the templates, the disabled one never.
database real
queue 1
rules tests/corpus/dyncfg/base.conf
chart loop.d1 loop.d1_name loop.dyncfg - things 1
chart loop.o1 loop.o1_name loop.other - things 1
var loop.d1 v 90
var loop.o1 v 90
register
clock 0
pass 0
store
dyncfg health:alert:prototype add d_three @tests/corpus/dyncfg/three.json
store
dyncfg health:alert:prototype:d_three get -
clock 1
pass 1
store
dyncfg health:alert:prototype:d_three update - @tests/corpus/dyncfg/two.json
store
clock 2
pass 2
store
configs
