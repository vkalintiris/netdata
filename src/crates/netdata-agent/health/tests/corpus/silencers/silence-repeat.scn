# A raised alert that repeats, silenced: each repeat's entry is made silenced, no command runs, and the wait that
# follows a repeat finds none. After a RESET the repeats are sent again.
rules tests/corpus/notify/repeat.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 70
clock 0
pass 0
manage ok cmd=SILENCE&alarm=n_repeat
clock 2
pass 2
clock 4
pass 4
manage ok cmd=RESET
clock 6
pass 6
