# DISABLE ALL: every alert is disabled and keeps its status, its value and its place in the counts; nothing is
# evaluated, repeated or notified while the value moves. After a RESET the alerts run at once.
rules tests/corpus/notify/repeat.conf
rules tests/corpus/notify/two.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 70
clock 0
pass 0
manage ok cmd=DISABLE ALL
clock 1
pass 1
var loop.n v 10
clock 2
pass 2
clock 3
pass 3
clock 10
pass 10
manage ok cmd=RESET
clock 11
pass 11
clock 12
pass 12
