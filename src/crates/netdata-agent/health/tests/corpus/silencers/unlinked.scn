# An alert whose chart left the host's index is not asked about: it keeps the flags it had, after the RESET too.
rules tests/corpus/notify/two.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 70
clock 0
pass 0
manage ok cmd=SILENCE ALL
clock 1
pass 1
manage ok cmd=RESET
clock 2
free-at-gate loop.n 2
pass 2
clock 3
unlink loop.n
