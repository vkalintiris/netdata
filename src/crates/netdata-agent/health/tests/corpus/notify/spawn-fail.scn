# A command that cannot be spawned: the record, the run mark without the in-progress one, and the entry is saved.
# For a repeat's entry the wait that follows finds no execution: its record, and code 128.
database real
rules tests/corpus/notify/repeat.conf
exec * * fail
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 10
clock 0
pass 0
var loop.n v 70
clock 1
pass 1
clock 2
pass 2
clock 3
pass 3
var loop.n v 10
clock 4
pass 4
clock 5
alarm-log 0
