# A timeout of 0 is no deadline: a command that takes five slices is waited for to its end, and the monotonic clock
# is read once, when the wait starts.
database real
timeout 0
rules tests/corpus/notify/plain.conf
exec * WARNING exit 5 0
chart loop.n loop.n_name loop.notify disks things 1
label loop.n kind ssd
var loop.n v 10
clock 0
pass 0
var loop.n v 70
clock 1
pass 1
var loop.n v 10
clock 2
pass 2
clock 3
alarm-log 0
