# no-clear-notification: the table is never asked; WARNING is sent, CLEAR is not (with its record), and the next
# WARNING is sent again.
database real
rules tests/corpus/notify/no-clear.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 10
clock 0
pass 0
var loop.n v 70
clock 1
pass 1
var loop.n v 10
clock 2
pass 2
var loop.n v 70
clock 3
pass 3
clock 4
alarm-log 0
