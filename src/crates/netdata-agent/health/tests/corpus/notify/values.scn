# What the command shows of odd numbers: a value that is not a number before a raise, huge and negative values, a
# time past 32 bits, and a clock that went back between two statuses (a negative duration: the CLEAR at the end).
rules tests/corpus/notify/values.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v nan
clock 0
pass 0
var loop.n v 1e300
clock 1
pass 1
var loop.n v -1e300
clock 2
pass 2
var loop.n v 10
clock 3
pass 3
last-executed CLEAR
var loop.n v -0.5
clock 3000000000
pass 3000000000
var loop.n v 123456789.987654321
clock 3000000100
pass 3000000100
last-executed WARNING
var loop.n v 10
clock 3000000050
pass 3000000050
