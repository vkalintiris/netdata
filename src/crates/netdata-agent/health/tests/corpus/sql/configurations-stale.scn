# The order follows what the statistics say, not what alert_hash holds: two rules (stored bb, aa) and `ANALYZE`,
# then two more rules (cc, dd) stored after it; the four are asked in an order that is not the table's. Then
# `ANALYZE` again, and the same asks. C answers all four in the table's order while the statistics say 2, and
# in the order asked once they say 4.
database real
sql INSERT INTO alert_hash (hash_id, date_updated, template, on_key, every, class) VALUES (x'b00000000000400080000000000000bb', 2000000000, 't_bb', 'ctx.bb', '1s', 'Class bb')
sql INSERT INTO alert_hash (hash_id, date_updated, template, on_key, every, class) VALUES (x'a00000000000400080000000000000aa', 2000000000, 't_aa', 'ctx.aa', '2s', 'Class aa')
sql ANALYZE
sql INSERT INTO alert_hash (hash_id, date_updated, template, on_key, every, class) VALUES (x'c00000000000400080000000000000cc', 2000000000, 't_cc', 'ctx.cc', '3s', 'Class cc')
sql INSERT INTO alert_hash (hash_id, date_updated, template, on_key, every, class) VALUES (x'd00000000000400080000000000000dd', 2000000000, 't_dd', 'ctx.dd', '4s', 'Class dd')
