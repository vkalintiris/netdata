# A reload when the user's directory is not there, without and with a stock one: the records, every alert REMOVED,
# and what the store holds.
health-dirs tests/corpus/reload/v1.d -
rules tests/corpus/reload/v1.d/a.conf
chart loop.r loop.r_name loop.reload disks things 1
var loop.r v 70
register
clock 0
pass 0
health-dirs tests/corpus/reload/none.d -
clock 1
reload
clock 2
pass 2
health-dirs tests/corpus/reload/none.d tests/corpus/reload/stock.d
clock 3
reload
clock 4
pass 4
