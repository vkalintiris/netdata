# A file alert updated and then removed by the user is gone until a reload: the file's rule and its alert are back.
health-dirs tests/corpus/reload/v1.d -
rules tests/corpus/reload/v1.d/a.conf
chart loop.r loop.r_name loop.reload disks things 1
chart loop.d1 loop.d1_name loop.dyncfg - things 1
var loop.r v 70
var loop.d1 v 70
register
clock 0
pass 0
dyncfg health:alert:prototype:r_change update - @tests/corpus/dyncfg/one.json
dyncfg-saved r_change @tests/corpus/dyncfg/one.json
clock 1
pass 1
clock 2
reload
clock 3
pass 3
dyncfg health:alert:prototype:r_change remove -
dyncfg-forget r_change
clock 4
pass 4
clock 5
reload
clock 6
pass 6
