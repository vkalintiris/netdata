# A file's job the user disabled: every reload reads its rule enabled, the core's echo disables it again, and it
# has no alert.
health-dirs tests/corpus/reload/v1.d -
rules tests/corpus/reload/v1.d/a.conf
chart loop.r loop.r_name loop.reload disks things 1
var loop.r v 70
dyncfg-user-disabled health:alert:prototype:r_gone
register
clock 0
pass 0
clock 1
pass 1
clock 2
reload
clock 3
pass 3
dyncfg-forget health:alert:prototype:r_gone
clock 4
reload
clock 5
pass 5
