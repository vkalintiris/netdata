# A reload after the files changed: a rule that is gone (its alert REMOVED and not linked again), a new one, one
# with another threshold (another hash; the alarm's id from the table).
database real
queue 1
health-dirs tests/corpus/reload/v1.d -
rules tests/corpus/reload/v1.d/a.conf
chart loop.r loop.r_name loop.reload disks things 1
var loop.r v 70
register
clock 0
pass 0
store
clock 1
pass 1
store
health-dirs tests/corpus/reload/v2.d -
clock 2
reload
store
clock 3
pass 3
store
clock 4
pass 4
store
configs
