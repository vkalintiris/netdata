# A reload over an entry that still waits for its delay, and over one whose command is running.
auto-wait 0
health-dirs tests/corpus/reload/delay.d -
rules tests/corpus/reload/delay.d/a.conf
chart loop.r loop.r_name loop.reload disks things 1
var loop.r v 70
register
clock 0
pass 0
clock 1
pass 1
clock 2
reload
wait
clock 3
pass 3
wait
clock 4
pass 4
wait
clock 9
pass 9
wait
