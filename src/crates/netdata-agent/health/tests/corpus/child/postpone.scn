# A reconnect with alerts postponed: the alerts are linked and not evaluated until the delay is over; the record of
# the resume.
rules tests/corpus/notify/two.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 70
clock 0
pass 0
clock 1
pass 1
clock 2
disconnect
health-enabled 1
gate 1
delay-up-to 10
clock 3
pass 3
clock 9
pass 9
clock 10
pass 10
clock 11
pass 11
