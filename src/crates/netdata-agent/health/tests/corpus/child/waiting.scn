# An entry that still waits for its delay at the detach: what becomes of it and of the alert's next entries after
# the reconnect.
rules tests/corpus/notify/delay.conf
chart loop.n loop.n_name loop.notify disks things 1
var loop.n v 70
clock 0
pass 0
clock 1
pass 1
clock 2
disconnect
health-enabled 1
gate 1
clock 3
pass 3
clock 4
pass 4
clock 5
pass 5
clock 8
pass 8
