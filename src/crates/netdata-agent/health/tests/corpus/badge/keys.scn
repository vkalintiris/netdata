# An alarm's name past the alert key's 1,023 bytes: the key is the chart and the name cut there, so the full name finds
# the alert, and so does a name that differs only past the cut.
rules tests/corpus/badge/badge.conf
chart b.lg b.lg_name b.long fam things 1
var b.lg v 70
clock 0
pass 0
clock 2
pass 2
badge chart=b.lg&
badge chart=b.lg&
