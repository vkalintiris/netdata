// Appended by gen-eval-vectors.sh to a copy of src/libnetdata/eval/eval-unittest.c, so that it reaches that file's
// static test_groups[] and test_variable_lookup(). Its main() runs C's own unit tests, which must pass, and writes
// C's unit vectors with what C actually returns for each:
//
//   c_unittest.tsv           one row per TestCase, in run order: C's hand-written expectations, then C's outputs and
//                            every variable lookup the evaluation made
//   c_unittest_hardcode.tsv  one row per HardcodeTestCase of eval-unittest-hardcoding.c, written by
//                            dump_hardcode_case(), which the script splices into a copy of that file's loop
//
// Field encoding: as gen-eval-vectors.c; a NULL string is written as "\x00", which no C string can hold.
// Lookups are joined with 0x1f; each is its found flag (0 or 1), 16 hex digits of the value, then the name.

static FILE *dump_hardcode_file;

static void dump_esc(FILE *f, const char *s) {
    if(!s) {
        fputs("\\x00", f);
        return;
    }
    for(const unsigned char *p = (const unsigned char *)s; *p; p++) {
        if(*p == '\\')
            fputs("\\\\", f);
        else if(*p >= 0x20 && *p <= 0x7e && *p != '#')
            fputc(*p, f);
        else
            fprintf(f, "\\x%02x", *p);
    }
}

static unsigned long long dump_bits(NETDATA_DOUBLE d) {
    uint64_t u;
    memcpy(&u, &d, sizeof(u));
    return (unsigned long long)u;
}

static FILE *dump_open(const char *dir, const char *name, const char *columns) {
    char path[4096];
    snprintf(path, sizeof(path), "%s/%s", dir, name);
    FILE *f = fopen(path, "w");
    if(!f) {
        fprintf(stderr, "cannot create %s\n", path);
        exit(1);
    }
    fprintf(f, "# generated by tests/oracle/gen-eval-vectors.sh from C's unit tests; do not edit\n");
    fprintf(f, "# columns: %s\n", columns);
    return f;
}

// the lookups of one evaluation, through C's own test callback
static FILE *dump_lookups_file;
static size_t dump_lookups_count;

static bool dump_variable_lookup(STRING *variable, void *data, NETDATA_DOUBLE *result) {
    bool found = test_variable_lookup(variable, data, result);
    if(dump_lookups_count++)
        fputs("\\x1f", dump_lookups_file);
    fprintf(dump_lookups_file, "%d%016llx", found ? 1 : 0, found ? dump_bits(*result) : 0ULL);
    dump_esc(dump_lookups_file, string2str(variable));
    return found;
}

// parse outcome, code, failed_at; false when the expression did not parse
static EVAL_EXPRESSION *dump_parse(FILE *f, const char *expression) {
    static const char untouched_at = '\0';
    const char *failed_at = &untouched_at;
    int error = -12345;
    EVAL_EXPRESSION *exp = expression_parse(expression, &failed_at, &error);
    if(exp)
        fprintf(f, "K\t%d\t-", error);
    else if(error == -12345 && failed_at == &untouched_at)
        fputs("E\t-\t-", f);
    else
        fprintf(f, "F\t%d\t%zu", error, (size_t)(failed_at - expression));
    return exp;
}

void dump_hardcode_case(size_t index, const char *name, const char *expression, const char *variable,
                        NETDATA_DOUBLE value, const char *expected_source, NETDATA_DOUBLE expected_result,
                        int expected_error) {
    FILE *f = dump_hardcode_file;
    fprintf(f, "%zu\t", index);
    dump_esc(f, name);
    fputc('\t', f);
    dump_esc(f, expression);
    fputc('\t', f);
    dump_esc(f, variable);
    fprintf(f, "\t%016llx\t", dump_bits(value));
    dump_esc(f, expected_source);
    fprintf(f, "\t%016llx\t%d\t", dump_bits(expected_result), expected_error);

    // what C's test does with a case (eval-unittest-hardcoding.c), on an expression of its own
    EVAL_EXPRESSION *exp = expression ? dump_parse(f, expression) : NULL;
    if(!exp) {
        if(!expression)
            fputs("-\t-\t-", f);
        fputs("\t-\t-\t-\t-\t-\t-\n", f);
        return;
    }

    STRING *var = variable ? string_strdupz(variable) : NULL;
    expression_hardcode_variable(exp, var, value);
    if(var)
        string_freez(var);

    fputc('\t', f);
    dump_esc(f, expression_source(exp));
    fputc('\t', f);
    dump_esc(f, expression_parsed_as(exp));
    int ret = expression_evaluate(exp);
    fprintf(f, "\t%d\t%d\t%016llx\t", ret, exp->error, dump_bits(exp->result));
    dump_esc(f, expression_error_msg(exp));
    fputc('\n', f);
    expression_free(exp);
}

static void dump_case(FILE *f, const TestGroup *group, int index) {
    const TestCase *tc = &group->test_cases[index];
    dump_esc(f, group->name);
    fprintf(f, "\t%d\t", index);
    dump_esc(f, tc->expression);
    fprintf(f, "\t%016llx\t%d\t%d\t", dump_bits(tc->expected_result), tc->expected_error, tc->should_parse ? 1 : 0);

    EVAL_EXPRESSION *exp = dump_parse(f, tc->expression);
    if(!exp) {
        fputs("\t-\t-\t-\t-\t-\t-\t-\n", f);
        return;
    }

    fputc('\t', f);
    dump_esc(f, expression_source(exp));
    fputc('\t', f);
    dump_esc(f, expression_parsed_as(exp));
    fputc('\t', f);

    // the lookups are written as they happen, so the evaluation's own fields follow them
    dump_lookups_file = f;
    dump_lookups_count = 0;
    expression_set_variable_lookup_callback(exp, dump_variable_lookup, NULL);
    int ret = expression_evaluate(exp);
    fprintf(f, "\t%d\t%d\t%016llx\t", ret, exp->error, dump_bits(exp->result));
    dump_esc(f, expression_error_msg(exp));
    fputc('\n', f);
    expression_free(exp);
}

int main(int argc, char **argv) {
    if(argc != 2) {
        fprintf(stderr, "usage: %s <output directory>\n", argv[0]);
        return 1;
    }

    string_init();

    dump_hardcode_file = dump_open(argv[1], "c_unittest_hardcode.tsv",
                                   "index, name, expression, variable, value bits, expected source, expected result "
                                   "bits, expected error, outcome (E/F/K), code, failed_at, source, parsed_as, return "
                                   "value, error code, result bits, error_msg (NULL strings are \\x00)");
    int failed = eval_unittest();
    fclose(dump_hardcode_file);
    if(failed) {
        fprintf(stderr, "C's unit tests failed: %d\n", failed);
        return 1;
    }

    FILE *f = dump_open(argv[1], "c_unittest.tsv",
                        "group, index, expression, expected result bits, expected error, should parse, outcome (E/F/K), "
                        "code, failed_at, source, parsed_as, lookups, return value, error code, result bits, error_msg");
    for(size_t g = 0; g < ARRAY_SIZE(test_groups); g++)
        for(int i = 0; i < test_groups[g].test_count; i++)
            dump_case(f, &test_groups[g], i);
    fclose(f);

    return 0;
}
